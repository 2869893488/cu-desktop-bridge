{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2869893488/cu-desktop-bridge/blob/main/payload-lock.schema.json",
  "title": "KimiCU community payload lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "payload", "node"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "files"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size", "sha256"],
            "properties": {
              "path": { "type": "string", "pattern": "^[^/\\\\]+([/\\\\][^/\\\\]+)*$" },
              "size": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumVersion"],
      "properties": {
        "minimumVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    }
  }
}
